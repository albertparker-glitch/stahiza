# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAILJS SERVER CONFIGURATION: Required for automatic server-side EmailJS REST dispatch.
# Configure these in your server environment / Secrets panel (kept off the client bundle).
EMAILJS_SERVICE_ID="MY_EMAILJS_SERVICE_ID"
EMAILJS_TEMPLATE_ID="MY_EMAILJS_TEMPLATE_ID"
# Optional separate template ID for general Contact & Inquiries form (defaults to EMAILJS_TEMPLATE_ID)
EMAILJS_CONTACT_TEMPLATE_ID="MY_EMAILJS_CONTACT_TEMPLATE_ID"
EMAILJS_PUBLIC_KEY="MY_EMAILJS_PUBLIC_KEY"
# Optional Private Key (accessToken) if strict server-side API access is enabled in EmailJS.
EMAILJS_PRIVATE_KEY="MY_EMAILJS_PRIVATE_KEY"

